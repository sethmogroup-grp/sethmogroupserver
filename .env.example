PORT=5000
MONGO_URI=
JWT_SECRET=use-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=12h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where the admin panel lives (used inside invitation / reset-password emails)
ADMIN_URL=https://admin.sethmogroup.com
# Public address of THIS API (used for the unsubscribe link inside newsletters)
API_PUBLIC_URL=https://sethmogroup-backend.onrender.com

# ---- Email (Nodemailer / SMTP) ----
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  (use an App Password, not your normal password)
# Other providers (Zoho, Microsoft 365, your hosting mail): use the host/port they give you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Sethmo Group
MAIL_FROM_ADDRESS=info@sethmogroup.com
# Where customer replies to your emails should go (optional - defaults to MAIL_FROM_ADDRESS)
MAIL_REPLY_TO=

# ---- First-time accounts (npm run seed:users) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Justine Mophat Chuungwe
CONTENT_MANAGER_EMAIL=
CONTENT_MANAGER_NAME=
SUPPORT_AGENT_EMAIL=
SUPPORT_AGENT_NAME=
